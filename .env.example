# Render PostgreSQL Database Connection URL
# Example: postgresql://user:password@dpg-xxxx-a.oregon-postgres.render.com/cryptofd?sslmode=require
DATABASE_URL=

# JWT Secret for Auth Tokens
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Resend Email Configuration (for OTP, Password Reset, Welcome & Withdrawal Emails)
RESEND_API_KEY=
EMAIL_FROM=AlienPay <noreply@alienpay.com>

# BSC (BEP-20) Blockchain RPC & USDT Contract Configuration
RPC_URL=https://bsc-rpc.publicnode.com
USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955

# HD Wallet Mnemonic (12 or 24 words) for deriving unique BEP-20 USDT deposit addresses per user (m/44'/60'/0'/0/index)
MNEMONIC=test test test test test test test test test test test junk

# Hot Wallet Address where derived user BEP-20 USDT deposits are swept (gas is hardcoded to 0.0001 BNB; withdrawals are manual via Admin Panel)
HOT_WALLET_ADDRESS=

# Hot Wallet Private Key (optional - used by Gas Dispenser to sponsor 0.0001 BNB gas to derived user addresses; falls back to HD master index 0 if not set)
HOT_WALLET_PRIVATE_KEY=

# Cloudinary Configuration for User Profile Pictures (Exact match with cryptofd)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Gemini API Key (optional)
GEMINI_API_KEY=

# Application Mode: leave empty (or 'user') for User App Service; set to 'admin' for standalone Admin Panel Service
VITE_APP_MODE=
